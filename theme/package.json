{
  "name": "valaxy-theme-arknights",
  "type": "module",
  "version": "0.1.1",
  "packageManager": "pnpm@10.34.4",
  "description": "An AK UI inspired reading and archive theme for Valaxy",
  "author": {
    "email": "me@yunyoujun.cn",
    "name": "YunYouJun",
    "url": "https://www.yunyoujun.cn"
  },
  "license": "MIT",
  "homepage": "https://arknights.valaxy.site/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valaxyjs/valaxy-theme-arknights.git",
    "directory": "theme"
  },
  "keywords": [
